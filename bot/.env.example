# Bot token from the Discord developer portal.
DISCORD_TOKEN=your-discord-bot-token
# Fine-grained GitHub token for Aewaterhouse/Cranky with Issues read and write only.
GITHUB_TOKEN=your-github-token
# Id of the ideas channel (text or forum). Turn on Developer Mode, right-click the channel, Copy Channel ID.
IDEAS_CHANNEL_ID=123456789012345678
# Name of the role whose members may post ideas and vote.
TEAM_ROLE=Crew
# Repository that receives the issues.
GITHUB_REPO=Aewaterhouse/Cranky
# Qualifying votes needed before an issue is created.
VOTES_NEEDED=2
# Reaction that counts as a vote.
VOTE_EMOJI=👍
# Reaction the bot adds once the issue exists.
DONE_EMOJI=✅
