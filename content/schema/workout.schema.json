{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workout plan",
  "type": "object",
  "required": ["id", "name", "blocks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "desc": { "type": "string" },
    "goal": { "enum": ["test", "bus", "recovery", "endurance", "tempo", "sweet-spot", "threshold", "vo2", "sprint"] },
    "test": { "enum": ["ramp", "ftp20"] },
    "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/block" } }
  },
  "definitions": {
    "pctOne": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 150 },
        {
          "type": "object",
          "required": ["hard", "medium", "easy"],
          "properties": {
            "hard": { "type": "number", "minimum": 0, "maximum": 150 },
            "medium": { "type": "number", "minimum": 0, "maximum": 150 },
            "easy": { "type": "number", "minimum": 0, "maximum": 150 }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["steady", "ramp", "over-under", "sprint", "free", "set"] },
        "dur": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "rep": { "type": "integer", "minimum": 1 },
        "pct": {
          "oneOf": [
            { "$ref": "#/definitions/pctOne" },
            { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/pctOne" } }
          ]
        },
        "blocks": { "type": "array", "items": { "$ref": "#/definitions/block" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "set" } } }, "then": { "required": ["rep", "blocks"] }, "else": { "required": ["dur"] } },
        { "if": { "properties": { "type": { "const": "sprint" } } }, "then": { "properties": { "dur": { "minimum": 5, "maximum": 30 } } } },
        { "if": { "properties": { "type": { "enum": ["steady", "ramp", "over-under"] } } }, "then": { "required": ["pct"] } },
        { "if": { "properties": { "type": { "const": "over-under" } } }, "then": { "required": ["step"] } }
      ]
    }
  }
}
